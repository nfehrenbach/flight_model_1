{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Editor",
            "type": "coreclr",
            "request": "launch",
            "program": "${env:godot-net-45}",
            // Change the arguments below for the project you want to test with.
            // To run the project instead of editing it, remove the "--editor" argument.
            "args": [
                "--editor",
                "--path",
                "${workspaceFolder}"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "console": "internalConsole"
        },
        {
            "name": "Run Game",
            "type": "coreclr",
            "request": "launch",
            "program": "${env:godot-net-45}",
            // Change the arguments below for the project you want to test with.
            // To run the project instead of editing it, remove the "--editor" argument.
            "args": [
                "--path",
                "${workspaceFolder}"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "preLaunchTask": "build"
        },
        {
            "name": "Select Scene",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${env:godot-net-45}",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "args": [
                "--path",
                "${workspaceFolder}",
                "${command:godot.csharp.getLaunchScene}"
            ]
        },
        {
            "name": "Attach to Process",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}